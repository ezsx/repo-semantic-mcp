SEMANTIC_MCP_COLLECTION_PREFIX=repo_semantic
SEMANTIC_MCP_INDEX_SCHEMA_VERSION=3
SEMANTIC_MCP_PROFILE_NAME=gpu_pplx_v100_infinity

# Docker Infinity on Tesla V100 with local pplx-embed-v1 model.
SEMANTIC_MCP_EMBEDDING_BACKEND=tei_http
SEMANTIC_MCP_EMBEDDING_BACKEND_ID=embedding/gpu_pplx_v100_infinity
SEMANTIC_MCP_EMBEDDING_MODEL=pplx-embed-v1
SEMANTIC_MCP_QUERY_TEMPLATE={query}
SEMANTIC_MCP_DOCUMENT_PREFIX=
SEMANTIC_MCP_TEI_QUERY_PROMPT_NAME=
SEMANTIC_MCP_TEI_DOCUMENT_PROMPT_NAME=
SEMANTIC_MCP_EMBEDDING_LOCATION_TYPE=docker
SEMANTIC_MCP_EMBEDDING_DEVICE_TYPE=gpu
SEMANTIC_MCP_EMBEDDING_MANAGED_BY_SERVICE=1
SEMANTIC_MCP_EMBEDDING_AUTOSTART_POLICY=explicit
SEMANTIC_MCP_EMBEDDING_HEALTH_PATH=/health

# Bundled Docker Infinity is addressed as http://tei:80 from the MCP container.
SEMANTIC_MCP_TEI_URL=
SEMANTIC_MCP_TEI_PORT=8084

# Local model mount. Windows path is mounted read-only to /models/pplx-embed-v1-0.6B.
SEMANTIC_MCP_INFINITY_MODEL_HOST_PATH=C:/llms/models/pplx-embed-v1-0.6B
SEMANTIC_MCP_INFINITY_SERVED_MODEL_NAME=pplx-embed-v1
# V100/Volta can return NaN/null vectors for multilingual pplx text under float16.
# Keep this profile conservative unless a model/runtime-specific fp16 fix is proven.
SEMANTIC_MCP_INFINITY_DTYPE=float32

# Stable V100 selection. Source: `nvidia-smi -L`.
SEMANTIC_MCP_NVIDIA_VISIBLE_DEVICES=GPU-8477a2fc-854e-0f8a-d878-75b28f274207
# With Docker Desktop on Windows the UUID device request may still expose both
# adapters, but V100 is cuda:0 when CUDA_DEVICE_ORDER is not forced.
SEMANTIC_MCP_CUDA_VISIBLE_DEVICES=0

SEMANTIC_MCP_TRANSPORT=http
SEMANTIC_MCP_HTTP_PORT=8011

SEMANTIC_MCP_WATCH_ENABLED=1
SEMANTIC_MCP_WATCH_DEBOUNCE_SEC=3
SEMANTIC_MCP_EMBED_BATCH_DOCS=32
SEMANTIC_MCP_EMBED_BATCH_CHARS=18000
SEMANTIC_MCP_MAX_CHUNK_CHARS=1000
SEMANTIC_MCP_QDRANT_PORT=6333
SEMANTIC_MCP_LOG_LEVEL=info
