SEMANTIC_MCP_COLLECTION_PREFIX=repo_semantic
SEMANTIC_MCP_INDEX_SCHEMA_VERSION=3
SEMANTIC_MCP_PROFILE_NAME=gpu_bge_m3

# GPU baseline profile: TEI on CUDA with the already validated model.
SEMANTIC_MCP_EMBEDDING_BACKEND=tei_http
SEMANTIC_MCP_EMBEDDING_BACKEND_ID=embedding/gpu_bge_m3_bundled_tei
SEMANTIC_MCP_EMBEDDING_MODEL=BAAI/bge-m3
SEMANTIC_MCP_QUERY_TEMPLATE={query}
SEMANTIC_MCP_DOCUMENT_PREFIX=
SEMANTIC_MCP_TEI_QUERY_PROMPT_NAME=
SEMANTIC_MCP_TEI_DOCUMENT_PROMPT_NAME=
SEMANTIC_MCP_EMBEDDING_LOCATION_TYPE=docker
SEMANTIC_MCP_EMBEDDING_DEVICE_TYPE=gpu
SEMANTIC_MCP_EMBEDDING_MANAGED_BY_SERVICE=1
SEMANTIC_MCP_EMBEDDING_AUTOSTART_POLICY=explicit
SEMANTIC_MCP_EMBEDDING_HEALTH_PATH=/health

# TEI container image/model settings
SEMANTIC_MCP_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cuda-1.9
SEMANTIC_MCP_TEI_MODEL_ID=BAAI/bge-m3
SEMANTIC_MCP_TEI_PORT=8081
SEMANTIC_MCP_TEI_DTYPE=float16

# Needed only for tei_http when not using the bundled compose service
SEMANTIC_MCP_TEI_URL=

# Optional future roles. Leave unset unless you really run these backends.
# SEMANTIC_MCP_RERANKER_BACKEND_ID=reranker/http_external_manual
# SEMANTIC_MCP_RERANKER_URL=http://host.docker.internal:8085
# SEMANTIC_MCP_COLBERT_BACKEND_ID=colbert/http_external_manual
# SEMANTIC_MCP_COLBERT_URL=http://host.docker.internal:8086

SEMANTIC_MCP_TRANSPORT=http
SEMANTIC_MCP_HTTP_PORT=8011

SEMANTIC_MCP_WATCH_ENABLED=1
SEMANTIC_MCP_WATCH_DEBOUNCE_SEC=3
SEMANTIC_MCP_EMBED_BATCH_DOCS=32
SEMANTIC_MCP_EMBED_BATCH_CHARS=18000
SEMANTIC_MCP_MAX_CHUNK_CHARS=1000
SEMANTIC_MCP_QDRANT_PORT=6333
SEMANTIC_MCP_LOG_LEVEL=info
